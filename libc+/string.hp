#ifndef _STRING_HP
#define _STRING_HP

#include <types>
#include <internal/_io>
#include <chars>
#include <memory>

namespace HIDDEN__STD__1
{
    const std::size_t INIT_LENGTH = 256;
} // namespace HIDDEN__STD__1

namespace std
{
    struct String
    {
        char       *__data;
        std::size_t __len;
        std::size_t __cap;

        static String new()
        {
            char *ptr = static_cast<char *>(std::allocateMemory(sizeof(char) * HIDDEN__STD__1::INIT_LENGTH));

            if (!ptr)
            {
                std::errputs("Out Of Memory, returning nullptr as data and 0 for the length (String::new).");
                return String {
                    __data: nullptr,
                    __len : 0,
                    __cap : HIDDEN__STD__1::INIT_LENGTH,
                };
            }

            ptr[0] = '\0';

            return String {
                __data: ptr,
                __len : 0,
                __cap : HIDDEN__STD__1::INIT_LENGTH,
            };
        } // static String std::String::new()

        static String fromChars(const char *const string)
        {
            if (!string)
                return String::new();

            std::size_t length = std::stringLengthWithNull(string);

            char *ptr = static_cast<char *>(std::allocateMemory(sizeof(char) * length));

            if (!ptr)
            {
                std::errputs("Out Of Memory, returning nullptr as data and 0 for the length and capacity is the original string length (String::fromChars).");
                return String {
                    __data: nullptr,
                    __len : 0,
                    __cap : length,
                };
            }

            std::copyString(ptr, string);

            return String {
                __data: ptr,
                __len : length - 1,
                __cap : length,
            };
        } // static std::String std::String::fromChars(const char *const string)

        void destroy(String *self)
        {
            if (!self)
                return;

            std::freeMemory(self->__data);

            self->__data = nullptr;
            self->__len  = 0;
            self->__cap  = 0;
        } // void std::String::destroy(std::String *self)

        void appendChars(String *self, const char *const string)
        {
            if (!self || !self->__data || !string)
                return;

            std::size_t appendLen = std::stringLength(string);
            std::size_t required  = self->__len + appendLen + 1;

            if (required > self->__cap)
            {
                std::size_t newCap = self->__cap;

                while (newCap < required)
                    newCap *= 2;

                char *ptr = static_cast<char *>(
                    std::reallocateMemory(self->__data, sizeof(char) * newCap)
                );

                if (!ptr)
                {
                    std::errputs("Out Of Memory, could not append (String::appendChars).");
                    return;
                }

                self->__data = ptr;
                self->__cap  = newCap;
            }

            std::copyString(self->__data + self->__len, string);

            self->__len += appendLen;
        } // void std::String::appendChars(std::String *self, const char *const string)

        const char *chars(const String *const self)
        {
            if (!self)
                return nullptr;

            return self->__data;
        } // const char *std::String::chars(const std::String *const self)

        const std::size_t length(const String *const self)
        {
            if (!self)
                return 0;
            return self->__len;
        }

        void appendString(String *self, const String *const other)
        {
            if (!self || !other)
                return;

            self->appendChars(other->chars());
        } // void std::String::appendString(std::String *self, const std::String *const other)
    } // struct String

    struct StringView
    {
        const char  *__data;
        std::size_t __len ; // fucking hell, nevermind, no pointer to an std::size_t, just a length of the INITIAL creation

        static StringView fromChars(const char *const _chpString)
        {
            return StringView {
                __data: _chpString,
                __len : std::stringLength(_chpString),
            };
        } // static std::StringView std::StringView::fromChars(const char *const _chpString)

        static StringView fromString(const String *const _strpString)
        {
            return StringView {
                __data: _strpString->__data,
                __len : _strpString->__len,
            };
        }

        const char *chars(const StringView *const self)
        {
            if (!self)
                return nullptr;
            return self->__data;
        } // const char *std::StringView::chars(const std::Stringview *const self)

        const std::size_t length(const StringView *const self)
        {
            if (!self)
                return 0;
            return self->__len;
        }
    } // struct StringView
} // namespace std

#endif