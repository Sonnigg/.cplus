// types.hp

#ifndef _TYPES_HP
#define _TYPES_HP

namespace std
{
    /*
        Integer types
    */
    typedef unsigned char       uint8_t;  // max: 2^8  - 1
    typedef unsigned short      uint16_t; // max: 2^16 - 1
    typedef unsigned int        uint32_t; // max: 2^32 - 1
    typedef unsigned long long  uint64_t; // max: 2^64 - 1

    typedef signed char         int8_t;   // min: 2^7 , max: 2^7  - 1
    typedef signed short        int16_t;  // min: 2^15, max: 2^15 - 1
    typedef signed int          int32_t;  // min: 2^31, max: 2^31 - 1
    typedef signed long long    int64_t;  // min: 2^63, max: 2^63 - 1

    /*
        Pointer-sized types
    */
#if CMPL__PTR_SIZE == 8
    typedef uint64_t ptrsize_t;
    typedef int64_t  sptrsize_t;

#elif CMPL__PTR_SIZE == 4
    typedef uint32_t ptrsize_t;
    typedef int32_t  sptrsize_t;

#elif CMPL__PTR_SIZE == 2
    typedef uint16_t ptrsize_t;
    typedef int16_t  sptrsize_t;

#elif CMPL__PTR_SIZE == 1
    typedef uint8_t ptrsize_t;
    typedef int8_t  sptrsize_t;

#else
    char UNSUPPORTED_PTR = '\1';

#endif
    typedef ptrsize_t size_t;
} // namespace std

#endif // #ifndef _TYPES_HP