// io.hp

// superset of _io.hp that introduces std::String returning functions

#ifndef _IO_HP
#define _IO_HP
#include <string>
#include <types>
#include <internal/_io>
#include <memory>

namespace std
{
    std::String readString()
    {
        char *tmp = std::readDynamic();

        std::String result = std::String::fromChars(tmp);

        std::freeMemory(tmp);

        return result;
    }
}

#endif // #ifndef _IO_HP