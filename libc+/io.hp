// io.hp

#ifndef _IO_HP
#define _IO_HP

#include <types>
#include <__utilities>
#include <string>

#ifdef _WIN32
#include <windows.h>
#else
#include <unistd.h>
#endif

namespace std
{

    void write_stdout(const char *const _chpString, std::ptrsize_t _pszLength)
    {
#ifdef _WIN32
        DWORD written = 0;

        WriteFile(
            GetStdHandle(STD_OUTPUT_HANDLE),
            _chpString,
            static_cast<DWORD>(_pszLength),
            &written,
            nullptr
        );
#else
        write(STDOUT_FILENO, _chpString, _pszLength);
#endif
    } // void std::write_stdout(const char *const _chpString, std::ptrsize_t _pszLength)

    void write_stderr(const char *const _chpString, std::ptrsize_t _pszLength)
    {
#ifdef _WIN32
        DWORD written = 0;

        WriteFile(
            GetStdHandle(STD_ERROR_HANDLE),
            _chpString,
            static_cast<DWORD>(_pszLength),
            &written,
            nullptr
        );
#else
        write(STDERR_FILENO, _chpString, _pszLength);
#endif
    }

    void get_stdin(char *const _chpBuffer, std::ptrsize_t _pszLength)
    {
#ifdef _WIN32
        DWORD read_bytes = 0;

        ReadFile(
            GetStdHandle(STD_INPUT_HANDLE),
            _chpBuffer,
            static_cast<DWORD>(_pszLength),
            &read_bytes,
            nullptr
        );
#else
        read(STDIN_FILENO, _chpBuffer, _pszLength);
#endif
    } // void std::get_stdin(char *const _chpBuffer, std::ptrsize_t _pszLength)

    /**
     * Reads a single character from stdin
     **/
    char getc()
    {
        char ch = '\0';
        std::get_stdin(&ch, 1);
        return ch;
    } // char std::getc()

    /**
     * Reads a string stream up to a maximum length (wrapper around get_stdin with null termination)
     **/
    void gets(char *const _chpBuffer, std::ptrsize_t _pszMaxLength)
    {
        if (_pszMaxLength == 0) return;

        // Read up to max length minus one to ensure space for null terminator
        std::ptrsize_t bytesToRead = _pszMaxLength - 1;
        std::get_stdin(_chpBuffer, bytesToRead);

        // Null terminate whatever was read
        for (std::ptrsize_t i = 0; i < bytesToRead; i++)
        {
            if (_chpBuffer[i] == '\n' || _chpBuffer[i] == '\r')
            {
                _chpBuffer[i] = '\0';
                return;
            }
        }
        _chpBuffer[bytesToRead] = '\0';
    } // void std::gets(char *const _chpBuffer, std::ptrsize_t _pszMaxLength)

    /**
     * Reads dynamically from stdin until a newline is encountered, returning a self-contained std::String.
     **/
    String readDynamic()
    {
        String str = String::new();
        char temp[2];
        temp[1] = '\0';

        while (true)
        {
            char ch = std::getc();
            if (ch == '\0') break; // EOF or stream end

            temp[0] = ch;
            str.appendChars(temp);

            if (ch == '\n') break;
        }

        return str;
    } // String std::readDynamic()

    /**
     * Puts a string to stdout
     **/
    void puts(
        const char *const _chpString
    )
    {
        std::write_stdout(_chpString, std::_chpLength(_chpString));
    } // void std::puts(const char *const _chpString)

    /**
     * Puts a character to stdout 
     **/
    void putc(
        const char _chChar
    )
    {
        std::write_stdout(&_chChar, 1);
    } // void std::putc(const char _chChar)

    /**
     * Puts a string to stderr
     **/
    void errputs(
        const char *const _chpString
    )
    {
        std::write_stderr(_chpString, std::_chpLength(_chpString));
    } // void std::errputs(const char *const _chpString)

    /**
     * Puts a character to stderr
     **/
    void errputc(
        const char _chChar
    )
    {
        std::write_stderr(&_chChar, 1);
    } // void std::errputs(const char _chpChar)

} // namespace std

#endif // #ifndef _IO_HP