#ifndef _MEMORY_HP
#define _MEMORY_HP

#include <types>

#if defined(_WIN32) || defined(_WIN64)
typedef unsigned long DWORD;
typedef void* LPVOID;
typedef std::uint64_t ULONG_PTR;
typedef ULONG_PTR SIZE_T;

#define MEM_COMMIT 0x00001000
#define MEM_RESERVE 0x00002000
#define MEM_RELEASE 0x00008000
#define PAGE_READWRITE 0x04

LPVOID VirtualAlloc(LPVOID lpAddress, SIZE_T dwSize, DWORD flAllocationType, DWORD flProtect);
int VirtualFree(LPVOID lpAddress, SIZE_T dwSize, DWORD dwFreeType);
long InterlockedCompareExchange(volatile long* Destination, long Exchange, long Comparand);

namespace HIDDEN__STD__2
{
    static volatile long _memory_lock = 0;

    static void memory_acquire_lock() {
        while (InterlockedCompareExchange(&_memory_lock, 1, 0) != 0) {
            // Spin
        }
    } // static void HIDDEN__STD__2::memory_acquire_lock()

    static void memory_release_lock() {
        _memory_lock = 0;
    } // static void HIDDEN__STD__2::memory_release_lock()

    static void *os_allocate(std::size_t size) {
        return VirtualAlloc(0, size, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
    } // static void *HIDDEN__STD__2::os_allocate(std::size_t size)

    static void os_free(void *ptr, std::size_t size) {
        static_cast<void>(size);
        if (ptr) {
            VirtualFree(ptr, 0, MEM_RELEASE);
        }
    } // static void HIDDEN__STD__2::os_free(void *ptr, std::size_t size)
} // namespace HIDDEN__STD__2

#else

#include <sys/mman.h>
#include <sys/types.h>

namespace HIDDEN__STD__2
{
    static volatile int _memory_lock = 0;

    static void memory_acquire_lock() {
        while (__atomic_test_and_set(&_memory_lock, __ATOMIC_ACQUIRE)) {
            // Spin
        }
    } // static void HIDDEN__STD__2::memory_acquire_lock()

    static void memory_release_lock() {
        __atomic_clear(&_memory_lock, __ATOMIC_RELEASE);
    } // static void HIDDEN__STD__2::memory_release_lock()

    static void *os_allocate(std::size_t size) {
        void *p = mmap(0, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
        if (p == static_cast<void *>(-1)) return 0;
        return p;
    } // static void *HIDDEN__STD__2::os_allocate(std::size_t size)

    static void os_free(void *ptr, std::size_t size) {
        if (ptr && size > 0) {
            munmap(ptr, size);
        }
    } // static void HIDDEN__STD__2::os_free(void *ptr, std::size_t size)
} // namespace HIDDEN__STD__2

#endif

namespace std
{
    #define _MEMORY_ALIGN 16
    #define _MEMORY_HEADER_SIZE ((sizeof(std::size_t) + _MEMORY_ALIGN - 1) & ~(_MEMORY_ALIGN - 1))

    void copyMemory(void *const _chpDest, const void *const _chpSource, std::size_t _szSize)
    {
        unsigned char *d = static_cast<unsigned char *>(_chpDest);
        const unsigned char *s = static_cast<const unsigned char *>(_chpSource);
        std::size_t idx = 0;
        for (; idx < _szSize; idx++)
        {
            d[idx] = s[idx];
        }
    } // void std::copyMemory(void *const _chpDest, const void *const _chpSource, std::size_t _szSize)

    void *moveMemory(void *const _chpDest, const void *const _chpSource, std::size_t _szSize)
    {
        unsigned char *d = static_cast<unsigned char *>(_chpDest);
        const unsigned char *s = static_cast<const unsigned char *>(_chpSource);
        if (d == s || _szSize == 0) return _chpDest;
        if (d < s) {
            std::size_t idx = 0;
            for (; idx < _szSize; idx++) {
                d[idx] = s[idx];
            }
        } else {
            std::size_t idx = _szSize;
            while (idx > 0) {
                idx--;
                d[idx] = s[idx];
            }
        }
        return _chpDest;
    } // void *std::moveMemory(void *const _chpDest, const void *const _chpSource, std::size_t _szSize)

    void *allocateMemory(std::size_t _szSize)
    {
        if (_szSize == 0) _szSize = 1;
        std::size_t total_size = _szSize + _MEMORY_HEADER_SIZE;
        
        HIDDEN__STD__2::memory_acquire_lock();
        void *raw = HIDDEN__STD__2::os_allocate(total_size);
        if (!raw) {
            HIDDEN__STD__2::memory_release_lock();
            return 0;
        }
        *(static_cast<std::size_t *>(raw)) = _szSize;
        void *user_ptr = static_cast<void *>(static_cast<char *>(raw) + _MEMORY_HEADER_SIZE);
        HIDDEN__STD__2::memory_release_lock();
        
        return user_ptr;
    } // void *std::allocateMemory(std::size_t _szSize)

    void freeMemory(void *const _chpPtr)
    {
        if (!_chpPtr) return;
        
        HIDDEN__STD__2::memory_acquire_lock();
        char *raw = static_cast<char *>(_chpPtr) - _MEMORY_HEADER_SIZE;
        std::size_t old_size = *(static_cast<std::size_t *>(raw));
        HIDDEN__STD__2::os_free(raw, old_size + _MEMORY_HEADER_SIZE);
        HIDDEN__STD__2::memory_release_lock();
    } // void std::freeMemory(void *const _chpPtr)

    void *reallocateMemory(void *const _chpPtr, std::size_t _szNewSize)
    {
        if (!_chpPtr) {
            return std::allocateMemory(_szNewSize);
        }
        if (_szNewSize == 0) {
            std::freeMemory(_chpPtr);
            return 0;
        }

        HIDDEN__STD__2::memory_acquire_lock();
        char *old_raw = static_cast<char *>(_chpPtr) - _MEMORY_HEADER_SIZE;
        std::size_t old_size = *(static_cast<std::size_t *>(old_raw));
        HIDDEN__STD__2::memory_release_lock();

        void *new_ptr = std::allocateMemory(_szNewSize);
        if (!new_ptr) return 0;

        std::size_t copy_size = old_size < _szNewSize ? old_size : _szNewSize;
        std::copyMemory(new_ptr, _chpPtr, copy_size);

        std::freeMemory(_chpPtr);

        return new_ptr;
    } // void *std::reallocateMemory(void *const _chpPtr, std::size_t _szNewSize)
} // namespace std

#endif